# Kopieren nach .env und ausfüllen:  cp .env.example .env
# .env ist per .gitignore ausgeschlossen und wird NIE eingecheckt.

# --- onOffice enterprise API (Extras > Einstellungen > API-Benutzer) ---
ONOFFICE_TOKEN=
ONOFFICE_SECRET=
# Stable-Endpoint lt. apidoc.onoffice.de (Live-Kunden). Beta-Kunden: .../api/latest/api.php
ONOFFICE_API_URL=https://api.onoffice.de/api/stable/api.php

# --- Sicherheit ---
# DRY_RUN=true: schreibende onOffice-Aktionen (create/modify/do sendmail) werden nur protokolliert.
DRY_RUN=true
# Kill-Switch für spätere Auto-Versand-Module (Phase 3). false = nichts wird automatisch verschickt.
AUTOMATION_ENABLED=false
# Testmodus: Kunden-Mails (später) nur an Adressen der Whitelist.
TESTMODE=true
TEST_WHITELIST=

# --- SMTP: Briefing/Wochenbericht gehen NUR an MAIL_TO (an mich selbst) ---
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
