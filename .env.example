# Kopiere diese Datei nach ".env" und trage deine echten Zugangsdaten ein.
# Die .env-Datei wird NIE eingecheckt (siehe .gitignore) -- Zugangsdaten
# stehen nirgends im Code.

# Variante 1: normaler Kickbase-Login mit Email + Passwort
KICKBASE_EMAIL=deine-email@example.com
KICKBASE_PASSWORD=dein-passwort

# Variante 2: fuer Accounts, die nur ueber "Mit Apple/Google anmelden" verknuepft
# sind (kein Passwort vorhanden) -- Token manuell aus dem Browser holen (siehe
# README "Login ueber Apple/Google") und HIER statt Email/Passwort eintragen:
# KICKBASE_AUTH_TOKEN=eingefuegter-token-oder-cookie-wert

# Optional, nur fuer eigenen Kader/Markt (nicht fuer die Kern-Datenbank noetig):
# KICKBASE_LEAGUE_ID=deine-liga-id

# Optional (Standardwerte greifen, wenn nicht gesetzt):
# KICKBASE_COMPETITION_ID=1
# KICKBASE_CACHE_DIR=.cache
# KICKBASE_REQUEST_DELAY_SECONDS=0.15
# KICKBASE_MAX_WORKERS=6
# KICKBASE_CACHE_TTL_VOLATILE=3600
# KICKBASE_CACHE_TTL_PERFORMANCE=86400
